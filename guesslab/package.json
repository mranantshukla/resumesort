{
  "name": "guesslab",
  "version": "0.1.0",
  "private": true,
  "description": "GuessLab: interactive guesstimate and product analyst learning platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
