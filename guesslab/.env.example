# Optional. Without these, GuessLab uses its built-in coach and stores progress in the browser.
# Set both to switch the tutor, interviewer and evaluator to OpenAI (server-side only; the key never reaches the browser).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
NEXT_PUBLIC_AI_PROVIDER=local   # "local" or "openai"
